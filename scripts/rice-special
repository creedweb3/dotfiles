#!/bin/sh
# rice-special browser|sysmon: show or hide a special workspace, starting its window the first time.
# hyprland.lua sends windows of class rice-browser / rice-sysmon to special:browser / special:sysmon.
#   browser  Brave in its own profile (~/.local/share/rice-browser), so it is a separate process
#            whose window keeps the rice-browser class; the normal browser (SUPER+B) is untouched.
#   sysmon   btop in kitty
set -eu
name=${1:-}
case $name in
    browser) cls=rice-browser
             start() { setsid -f brave --class=rice-browser --user-data-dir="$HOME/.local/share/rice-browser" >/dev/null 2>&1; } ;;
    sysmon)  cls=rice-sysmon
             start() { setsid -f kitty --class rice-sysmon -e btop >/dev/null 2>&1; } ;;
    *) echo "usage: rice-special browser|sysmon" >&2; exit 2 ;;
esac

if ! hyprctl clients -j | jq -e --arg c "$cls" 'any(.[]; .class == $c)' >/dev/null; then
    start
    # wait (up to 5 s) for the window, so the toggle below shows it
    i=0
    while [ $i -lt 25 ] && ! hyprctl clients -j | jq -e --arg c "$cls" 'any(.[]; .class == $c)' >/dev/null; do
        sleep 0.2
        i=$((i + 1))
    done
fi
hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$name\")" >/dev/null

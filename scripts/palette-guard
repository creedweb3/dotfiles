#!/usr/bin/env python3
"""Decide how the theme draws on its wallpaper.

The accent comes from the wallpaper, so on a bright wallpaper the borders,
workspace boxes and bar symbol (drawn in the accent, straight on the
wallpaper) vanish into it. Then the guard switches on "bright" mode: those
parts use the theme's own dark and light tints of the same hue instead of the
accent (solid dark tiles, light-tint highlights, dark symbol), so nothing
adds a second colour, an outline or darkens the wallpaper.

The accent itself is only lightened if it is unreadable on the dark panels.

Rules (WCAG contrast ratio):
    accent vs panel                                     >= 3
    accent vs each area covering >= 20% of the wallpaper, >= 2, or >= 3 when the
    and vs the spot behind the bar symbol                  hues are close
    (any failure here means bright mode)

Usage: palette-guard <wallpaper> <palette.json>
    palette.json: {"panel", "accent"} as #rrggbb.
    Prints the palette plus "bright" (true/false) and a "guard" report.
"""
import colorsys, json, sys
from PIL import Image

PANEL_MIN, MIN, MIN_SAME_HUE, SAME_HUE_DEG, BIG_AREA = 3.0, 2.0, 3.0, 40, .20


def rgb(h):
    return tuple(int(h[i:i + 2], 16) / 255 for i in (1, 3, 5))


def hexc(c):
    return "#%02X%02X%02X" % tuple(round(max(0, min(1, v)) * 255) for v in c)


def lum(h):
    f = lambda c: c / 12.92 if c <= .03928 else ((c + .055) / 1.055) ** 2.4
    r, g, b = map(f, rgb(h))
    return .2126 * r + .7152 * g + .0722 * b


def contrast(a, b):
    hi, lo = sorted((lum(a), lum(b)), reverse=True)
    return (hi + .05) / (lo + .05)


def hue_close(a, b):
    (ha, la, sa), (hb, lb, sb) = (colorsys.rgb_to_hls(*rgb(x)) for x in (a, b))
    if sa < .25 or sb < .25 or la < .08 or lb < .08:  # grey or near-black: no hue to clash
        return False
    d = abs(ha - hb) * 360
    return min(d, 360 - d) < SAME_HUE_DEG


def areas(path):
    """Colours covering at least BIG_AREA of the wallpaper, plus the spot behind
    the bar's centre symbol (wallpaper cropped 16:9 like the desktop)."""
    im = Image.open(path).convert("RGB")
    w, h = im.size
    cw, ch = (w, w * 9 / 16) if w / h < 16 / 9 else (h * 16 / 9, h)
    im = im.crop((int((w - cw) / 2), int((h - ch) / 2), int((w + cw) / 2), int((h + ch) / 2)))
    q = im.resize((96, 54)).quantize(8)
    pal, counts = q.getpalette(), q.getcolors()
    total = sum(n for n, _ in counts)
    big = [("#%02X%02X%02X" % tuple(pal[i * 3:i * 3 + 3]), f"{n / total:.0%}") for n, i in sorted(counts, reverse=True) if n / total >= BIG_AREA]
    cw, ch = im.size
    spot = im.crop((int(cw * .485), int(ch * .005), int(cw * .515), int(ch * .04))).resize((1, 1), Image.BOX).getpixel((0, 0))
    return big + [("#%02X%02X%02X" % spot, "bar centre")]


def wall_fails(c, regions):
    return [f"{col} ({where}) {contrast(c, col):.1f}" for col, where in regions
            if contrast(c, col) < (MIN_SAME_HUE if hue_close(c, col) else MIN)]


def guard(path, p):
    regions, report = areas(path), {}
    acc = p["accent"]
    hh, l, s = colorsys.rgb_to_hls(*rgb(acc))
    while contrast(acc, p["panel"]) < PANEL_MIN and l < .92:  # unreadable on the panel: lighten
        l = min(.92, l + .05)
        acc = hexc(colorsys.hls_to_rgb(hh, l, s))
    if acc != p["accent"]:
        report["accent_lightened_from"] = p["accent"]
    fails = wall_fails(acc, regions)
    if fails:
        report["bright_because"] = fails
    report["areas"] = regions
    return dict(p, accent=acc, bright=bool(fails), guard=report)


if __name__ == "__main__":
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    print(json.dumps(guard(sys.argv[1], json.load(open(sys.argv[2]))), indent=1))
